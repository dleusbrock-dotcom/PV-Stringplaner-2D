# Öffentliche Supabase-Projektdaten (Supabase-Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-oder-publishable-key>

# Nur serverseitig! Wird ausschließlich für die Benutzerverwaltung (Einladen) benötigt.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Öffentliche Basis-URL der App (für Einladungs- und Passwort-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
